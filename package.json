{
  "name": "thumbrella-web",
  "version": "1.5.0",
  "description": "Project website and documentation for Thumbrella thumbnail platform.",
  "homepage": "https://thumbrella.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterShinners/thumbrella-web"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:wrangler": "astro build && wrangler dev --no-bundle",
    "deploy": "astro build --logLevel warn && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "keywords": [
    "thumbrella",
    "thumbnails",
    "media",
    "documentation"
  ],
  "author": "Peter Shinners <pete@thumbrella.dev>",
  "license": "Apache-2.0",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.41.0",
    "@floating-ui/dom": "^1.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wrangler": "^4.135.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "workerd@1.20260828.1": true
  }
}
