---
import Search from '@astrojs/starlight/components/Search.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import { getCollection } from 'astro:content';

const currentRoute = Astro.locals.starlightRoute;
const currentId = currentRoute.id.replace(/\/index$/, '');

const docs = await getCollection('docs');

// Build pages array with H2/H3 headings extracted from raw markdown body.
// We can't use entry.render() because it's not available in the workerd SSR runtime.
function extractHeadings(body) {
  const headings = [];
  const re = /^(#{2,3})\s+(.+)$/gm;
  let m;
  while ((m = re.exec(body)) !== null) {
    const level = m[1].length;
    const text = m[2].trim();
    const slug = text
      .toLowerCase()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
    headings.push({ level, text, slug });
  }
  return headings;
}

// Nest H3s under their parent H2
function nestHeadings(headings) {
  const result = [];
  let currentH2 = null;
  for (const h of headings) {
    if (h.level === 2) {
      currentH2 = { ...h, h3s: [] };
      result.push(currentH2);
    } else if (h.level === 3 && currentH2) {
      currentH2.h3s.push(h);
    }
  }
  return result;
}

const pages = docs.map((entry) => {
  const slug = entry.id.replace(/\/index$/, '');
  const headings = nestHeadings(extractHeadings(entry.body || ''));
  return { slug, title: entry.data.title, headings };
});

// Sidebar page order. Must match the `sidebar.items` array in astro.config.mjs.
// Changes to this list will break prev/next pagination unless the config is
// updated too. When adding or reordering pages, update both locations.
const slugOrder = [
  'docs',
  'docs/project',
  'docs/pricing',
  'docs/sponsor',
  'docs/faq',
  'docs/client',
  'docs/components',
  'docs/http-api',
  'docs/server',
  'docs/cloud',
  'docs/development',
];
pages.sort((a, b) => slugOrder.indexOf(a.slug) - slugOrder.indexOf(b.slug));
---

<div class="sidebar-search">
  <Search />
</div>
<SidebarPersister>
  <nav class="sidebar-nav" aria-label="Documentation">
    <ul class="sidebar-tree">
      {pages.map((page) => {
        const isCurrent = page.slug === currentId;
        const href = page.slug === 'docs' ? '/docs/' : `/${page.slug}/`;
        const hasGapBefore = page.slug === 'docs/client' || page.slug === 'docs/server' || page.slug === 'docs/development'|| page.slug === 'docs/project';
        return (
          <li class:list={{ 'sidebar-gap': hasGapBefore }}>
            <a
              href={href}
              class:list={['sidebar-page-link', { current: isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              {page.title}
            </a>
            {isCurrent && page.headings.length > 0 && (
              <ul class="sidebar-headings">
                {page.headings.map((h2) => (
                  <>
                    <li>
                      <a href={`${href}#${h2.slug}`} class="sidebar-heading-link">
                        {h2.text}
                      </a>
                    </li>
                    {/* {h2.h3s.length > 0 && (
                      <ul class="sidebar-subheadings">
                        {h2.h3s.map((h3) => (
                          <li>
                            <a href={`${href}#${h3.slug}`} class="sidebar-subheading-link">
                              {h3.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )} */}
                  </>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .sidebar-tree {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-page-link {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: background 0.15s;
  }
  .sidebar-page-link:hover {
    background: var(--sl-color-gray-6);
  }
  .sidebar-page-link.current {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }
  .sidebar-gap {
    margin-top: 1rem;
  }
  .sidebar-headings {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem 0.875rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }
  .sidebar-heading-link {
    display: block;
    padding: 0.1rem 0.9rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .sidebar-heading-link:hover {
    color: var(--sl-color-white);
  }
  .sidebar-subheadings {
    list-style: none;
    padding: 0;
    margin: 0 0 0.25rem 0.75rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }
  .sidebar-subheading-link {
    display: block;
    padding: 0 1.2rem 0.1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .sidebar-subheading-link:hover {
    color: var(--sl-color-white);
  }
</style>
