---
---

<section class="hp-section hp-section--no-border">
  <div class="container">
    <h2 class="section-heading">News</h2>
    <div class="caps-panel">
      <a class="news-featured" href="https://youtu.be/HVQ6wjGKZCc">
        <img
          class="news-featured-thumb"
          src="https://i.ytimg.com/vi/HVQ6wjGKZCc/mqdefault.jpg"
          alt=""
          loading="lazy"
        />
        <span class="news-featured-text">
          <span class="news-featured-title">Quick Developer Intro Video</span>
          <span class="news-featured-host">youtube.com</span>
        </span>
      </a>
      <ul class="news-list" id="news-list">
        <li class="news-placeholder">Loading news&hellip;</li>
      </ul>
      <p class="news-footer">
        <a href="https://github.com/orgs/thumbrella-dev/discussions/categories/news">View all discussions &rarr;</a>
      </p>
    </div>
  </div>
</section>

<script>
  interface NewsItem {
    title: string;
    url: string;
    updatedAt: string;
    bodyPreview: string;
  }

  function relativeTime(iso: string): string {
    const diff = Date.now() - new Date(iso).getTime();
    const secs = Math.floor(diff / 1000);
    if (secs < 40) return 'just now';
    if (secs < 100) return 'a minute ago';
    const mins = Math.floor(secs / 60);
    if (mins < 40) return `${mins} minutes ago`;
    if (mins < 100) return 'an hour ago';
    const hours = Math.floor(mins / 60);
    if (hours < 22) return `${hours} hours ago`;
    if (hours < 40) return 'a day ago';
    const days = Math.floor(hours / 24);
    if (days < 26) return `${days} days ago`;
    if (days < 50) return 'a month ago';
    const months = Math.floor(days / 30);
    return `${months} months ago`;
  }

  function renderNews(items: NewsItem[]): void {
    const list = document.getElementById('news-list');
    if (!list) return;

    if (items.length === 0) {
      list.innerHTML = '<li class="news-placeholder">No recent news.</li>';
      return;
    }

    list.innerHTML = items
      .map(
        (item) => `
        <li class="news-item">
          <div class="news-line1">
            <a class="news-title" href="${item.url}">${item.title}</a>
            <span class="news-date">${relativeTime(item.updatedAt)}</span>
          </div>
          ${item.bodyPreview ? `<p class="news-preview">${item.bodyPreview}</p>` : ''}
        </li>`
      )
      .join('');
  }

  const NEWS_TIMEOUT_MS = 6000;

  fetch('/api/news', { signal: AbortSignal.timeout(NEWS_TIMEOUT_MS) })
    .then((res) => {
      // In `astro dev` the route is not served by the worker, so this comes back
      // as the Vite 404 HTML page rather than JSON.
      if (!res.ok) throw new Error(`news request failed: ${res.status}`);
      return res.json();
    })
    .then((data: NewsItem[]) => renderNews(Array.isArray(data) ? data : []))
    .catch(() => renderNews([]));
</script>

<style is:global>

  div.serverstatus {
    width: 60%;
    margin: 0 auto;
    text-align: center;
    max-width: 800px;
    word-wrap: normal;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid var(--border);
    padding: 1rem 2rem;
    border-radius: 14px;
    line-height: 2;
    margin-bottom: 1rem;
  }
  img.serverstatus {
    vertical-align: middle;
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    min-height: 8lh;
  }

  .news-placeholder {
    list-style: none;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .news-featured {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem;
    color: var(--text);
    text-decoration: none;
  }

  .news-featured-thumb {
    flex-shrink: 0;
    width: 12rem;
    max-width: 40%;
    height: 3.8rem;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.22);
  }

  .news-featured-text {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-width: 0;
  }

  .news-featured-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .news-featured-host {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .news-featured-host::before {
    content: "- ";
  }

  .news-featured:hover .news-featured-title {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .news-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.48rem;
    padding-left: 1rem;
  }

  .news-item::before {
    content: "\2022";
    position: absolute;
    top: 0.48rem;
    left: 0.1rem;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--accent-strong);
  }

  .news-line1 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-weight: 600;
  }

  .news-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    line-height: 1.35;
    flex: 1;
    min-width: 0;
  }

  .news-title:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .news-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .news-preview {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
    padding-left: 0.8em;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .news-footer {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    padding-top: 0.85rem;
  }


  .news-footer a {
    color: var(--accent-strong);
    text-decoration: none;
  }

  .news-footer a:hover {
    text-decoration: underline;
  }
</style>
